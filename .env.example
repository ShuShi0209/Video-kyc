# Docker configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Backend configuration
DATABASE_URL=
STORAGE_DIR=../storage
MAX_RETRIES=3

# AI Providers (Empty for V1 initial)
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# --- Optional tuning (defaults shown) ---------------------------------------
# MAX_RETRIES is the default number of automatic tries per step; override per step if needed.
# FACE_MAX_RETRIES=3
# LIVENESS_MAX_RETRIES=3
# FACE_MIN_QUALITY=0.5
# LIVENESS_MIN_SCORE=0.5
# MAX_UPLOAD_BYTES=524288000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
